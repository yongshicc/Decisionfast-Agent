    {
      "parameters": {
        "resume": "form",
        "formTitle": "DecideFast — Human Review Needed",
        "formDescription": "={{ 'The Kev model was not confident enough to decide automatically (probability ' + $('Classify Decision').item.json.probability + ', auto range ≤ ' + $('Config').item.json.auto_no_max + ' or ≥ ' + $('Config').item.json.auto_yes_min + '). Request ' + $execution.id + '. Complaint: ' + $('Config').item.json.complaint }}",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Does this complaint concern the service brakes or braking system?",
              "fieldType": "radio",
              "fieldOptions": {
                "values": [
                  {
                    "option": "YES"
                  },
                  {
                    "option": "NO"
                  },
                  {
                    "option": "ESCALATE"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Reviewer name",
              "requiredField": true
            },
            {
              "fieldLabel": "Reviewer notes",
              "fieldType": "textarea"
            }
          ]
        },
        "limitWaitTime": true,
        "resumeAmount": 72,
        "options": {
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Thank you. Your review decision has been recorded."
            }
          }
        }
      },

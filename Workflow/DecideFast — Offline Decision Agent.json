    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-endpoint",
              "name": "kev_endpoint",
              "type": "string",
              "value": "http://127.0.0.1:8010/v1/systemone"
            },
            {
              "id": "cfg-model",
              "name": "model_name",
              "type": "string",
              "value": "local"
            },
            {
              "id": "cfg-no",
              "name": "auto_no_max",
              "type": "number",
              "value": 0.01
            },
            {
              "id": "cfg-yes",
              "name": "auto_yes_min",
              "type": "number",
              "value": 0.99
            },
            {
              "id": "cfg-timeout",
              "name": "timeout_ms",
              "type": "number",
              "value": 30000
            },
            {
              "id": "cfg-max",
              "name": "max_complaint_chars",
              "type": "number",
              "value": 8000
            },
            {
              "id": "cfg-complaint",
              "name": "complaint",
              "type": "string",
              "value": "={{ typeof $json.body?.complaint === 'string' ? $json.body.complaint.trim() : '' }}"
            },
            {
              "id": "cfg-cid",
              "name": "complaint_id",
              "type": "string",
              "value": "={{ (v => (typeof v === 'string' || typeof v === 'number') && String(v).trim() !== '' ? String(v).trim().slice(0, 128) : 'req-' + $execution.id)($json.body?.complaint_id) }}"
            },
            {
              "id": "cfg-mver",
              "name": "model_version",
              "type": "string",
              "value": "kev-0.8b-nhtsa-mlx"
            },
            {
              "id": "cfg-audit",
              "name": "audit_table",
              "type": "string",
              "value": "decidefast_review_audit"
            },
            {
              "id": "cfg-ctype",
              "name": "complaint_received_type",
              "type": "string",
              "value": "={{ $json.body?.complaint === undefined || $json.body?.complaint === null ? 'missing' : typeof $json.body.complaint }}"
            }
          ]
        },
        "options": {}
      },
      "id": "5724b0af-911a-4192-9c0c-68df992ca652",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        272,
        224
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.complaint }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "leftValue": "={{ $json.complaint.length }}",
              "rightValue": "={{ $json.max_complaint_chars }}",
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ]
        },
        "looseTypeValidation": true,
        "options": {}
      },

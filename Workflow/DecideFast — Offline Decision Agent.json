    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.kev_endpoint }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": {{ JSON.stringify($json.model_name) }},\n  \"state\": {{ JSON.stringify($json.complaint) }},\n  \"questions\": {\n    \"brakes\": {\n      \"type\": \"noul\",\n      \"instructions\": \"Does this consumer vehicle safety complaint concern the service brakes or braking system?\"\n    }\n  }\n}",
        "options": {
          "response": {
            "response": {}
          },
          "timeout": "={{ $json.timeout_ms }}"
        }
      },
      "id": "4bcf0f8e-5ea5-4524-b55d-8063d37f5ace",
      "name": "Call Kev Model",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        800,
        320
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ (v => v !== null && v !== undefined && v !== '' && typeof v !== 'boolean' && !isNaN(Number(v)) && Number(v) >= 0 && Number(v) <= 1)($json.answers?.brakes?.noul) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "79aecb5d-b8f2-49f9-8142-e4dc55102463",
      "name": "Is Model Response Valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1024,
        224
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cd-prob",
              "name": "probability",
              "type": "number",
              "value": "={{ Number($json.answers.brakes.noul) }}"
            },
            {
              "id": "cd-dec",
              "name": "decision",
              "type": "string",
              "value": "={{ Number($json.answers.brakes.noul) <= $('Config').item.json.auto_no_max ? 'AUTO_NO' : (Number($json.answers.brakes.noul) >= $('Config').item.json.auto_yes_min ? 'AUTO_YES' : 'HUMAN_REVIEW') }}"
            },
            {
              "id": "cd-model",
              "name": "model",
              "type": "string",
              "value": "={{ $json.model ?? $json.model_name ?? $('Config').item.json.model_name }}"
            },
            {
              "id": "cd-lat",
              "name": "inference_latency_ms",
              "type": "number",
              "value": "={{ Date.now() - $('Mark Inference Start').item.json.started_at_ms }}"
            },
            {
              "id": "cd-kevlat",
              "name": "model_reported_latency_ms",
              "type": "string",
              "value": "={{ String($json.latency_ms ?? $json.inference_ms ?? $json.timings?.total_ms ?? 'not reported') }}"
            },
            {
              "id": "cd-thr",
              "name": "thresholds",
              "type": "object",
              "value": "={{ { auto_no_max: $('Config').item.json.auto_no_max, auto_yes_min: $('Config').item.json.auto_yes_min } }}"
            }
          ]
        },
        "options": {}
      },
